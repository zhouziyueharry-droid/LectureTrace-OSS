# API Key 推荐在网页的设置页填写（保存在本机数据库）；这里的值只在设置页未填写时作为后备
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # 换成 https://api.deepseek.com 等兼容接口
ANTHROPIC_API_KEY=

# TRANSLATOR=deepl   # deepl | google | llm；设置页选择优先
# LLM_MODEL=claude-sonnet-5
# DISABLED_STAGES=read_slides,evidence,outline   # 暂未启用的阶段；置空则全部启用

# ASR_MODEL=large-v3
# 默认轻量模式：不下载/加载本地模型。完整模式先安装 asr/cuda extra，再改为 true。
ASR_ENABLED=false
# ASR_DEVICE=cuda
# ASR_COMPUTE_TYPE=float16
# ASR_BATCH_SIZE=16   # 批量识别，0 为顺序识别（显存不足时可调小）
